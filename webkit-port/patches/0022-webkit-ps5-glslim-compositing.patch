+#if defined(PS5_HOMEBREW)
+// PS5: Sony's GLES library (libSceGLSlimVSH) has no GLSL compiler. Its
+// glShaderBinary takes the TextureMapper programs Sony's own WebKit ships
+// precompiled (libSceNKWebKitRequirements.sprx, set 616): v<options>.vert /
+// f<options>.frag for common option sets, and an "uber" pair for the rest,
+// which reads the options from u_optionsMatrix. Their option numbers are this
+// class's Option bits. The binaries are the console's own and are not
+// distributed: they are read from $PROSPEROWEB_SHADER_DIR (default
+// /data/prosperoweb/shaders/616_texmap_<name>.bin).
+extern "C" void ps5_glslim_log(const char*, ...) __attribute__((weak));
+
+static Vector<uint8_t> readShaderBinary(const char* name)
+{
+    const char* dir = getenv("PROSPEROWEB_SHADER_DIR");
+    char path[256];
+    snprintf(path, sizeof path, "%s/616_texmap_%s.bin", dir && *dir ? dir : "/data/prosperoweb/shaders", name);
+    Vector<uint8_t> data;
+    FILE* file = fopen(path, "rb");
+    if (!file)
+        return data;
+    uint8_t buffer[4096];
+    size_t count;
+    while ((count = fread(buffer, 1, sizeof buffer, file)) > 0)
+        data.append(std::span<const uint8_t> { buffer, count });
+    fclose(file);
+    return data;
+}
