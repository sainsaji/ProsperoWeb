+void AcceleratedSurface::ps5EnsureFramebuffer(const IntSize& size)
+{
+    if (m_ps5Framebuffer && m_ps5Size == size)
+        return;
+    if (!m_ps5Framebuffer)
+        glGenFramebuffers(1, &m_ps5Framebuffer);
+    if (!m_ps5Texture)
+        glGenTextures(1, &m_ps5Texture);
+    glBindTexture(GL_TEXTURE_2D, m_ps5Texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, size.width(), size.height(), 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, m_ps5Framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_ps5Texture, 0);
+    GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    m_ps5Size = size;
+    m_ps5FastOk = false;
+    m_ps5WholeMode = false;
+    m_ps5ProbeCounter = 0;
+    if (ps5MesaActive() && ps5MesaOptions().fast && ps5_mesa_proc && ps5_mesa_proc("glBlitFramebuffer")) {
+        const char* ext = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+        if (ext && strstr(ext, "GL_EXT_read_format_bgra")) {
+            if (!m_ps5FlipFramebuffer)
+                glGenFramebuffers(1, &m_ps5FlipFramebuffer);
+            if (!m_ps5FlipTexture)
+                glGenTextures(1, &m_ps5FlipTexture);
+            glBindTexture(GL_TEXTURE_2D, m_ps5FlipTexture);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, size.width(), size.height(), 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+            glBindTexture(GL_TEXTURE_2D, 0);
+            glBindFramebuffer(GL_FRAMEBUFFER, m_ps5FlipFramebuffer);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_ps5FlipTexture, 0);
+            m_ps5FastOk = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+            glBindFramebuffer(GL_FRAMEBUFFER, m_ps5Framebuffer);
+        }
+        PS5_SURFACE_LOG("surface: whole-frame fast path %s", m_ps5FastOk ? "on" : "unavailable");
+    }
+    m_ps5Pixels.resize(static_cast<size_t>(size.width()) * size.height() * 4);
+    m_ps5Previous.resize(m_ps5Pixels.size());
+    m_ps5HavePrevious = false;
+    PS5_SURFACE_LOG("surface: framebuffer %dx%d, status %#x, error %#x", size.width(), size.height(), status, glGetError());
+    if (ps5MesaActive())
+        PS5_SURFACE_LOG("surface: send %s, pace %u ms", ps5MesaOptions().diff ? "changed rects" : "whole frames", ps5MesaOptions().paceMs);
+}
+
+void AcceleratedSurface::ps5FinishFrame()
+{
+    const unsigned paceMs = ps5MesaActive() ? ps5MesaOptions().paceMs : 0;
+    const Seconds left = Seconds::fromMilliseconds(paceMs) - (MonotonicTime::now() - m_ps5FrameStart);
+    if (paceMs && m_ps5PaceTimer && left > 0_s) {
+        m_ps5Stats.paced++;
+        m_ps5PaceTimer->startOneShot(left);
+        return;
+    }
+    frameDone();
+}
+
+void AcceleratedSurface::ps5PaceTimerFired()
+{
+    frameDone();
+}
+
+void AcceleratedSurface::ps5LogStats(MonotonicTime now)
+{
+    auto& s = m_ps5Stats;
+    if (!s.since)
+        s.since = now;
+    if (now - s.since < 5_s)
+        return;
+    const double frames = std::max(1u, s.frames);
+    PS5_SURFACE_LOG("surface: %.0fs %dx%d: %u frames, %u sent (avg %.1f kpx), %u unchanged, %u paced, %u whole-fast | avg ms: render %.2f readback %.2f diff %.2f copy %.2f",
+        (now - s.since).seconds(), m_ps5Size.width(), m_ps5Size.height(), s.frames, s.sent, s.sent ? s.sentPixels / s.sent / 1000 : 0.0,
+        s.unchanged, s.paced, s.fast, s.renderMs / frames, s.readMs / frames, s.diffMs / frames, s.copyMs / frames);
+    s = { };
+    s.since = now;
+}
+
+void AcceleratedSurface::ps5ReadBackAndSend()
+{
+    // The frame is on the GPU and finished: GLContext::swapBuffers ran the
+    // shell's frame end (flush + wait for the frame's GPU label).
+    const auto size = m_ps5Size;
+    const MonotonicTime start = MonotonicTime::now();
+    m_ps5Stats.frames++;
+    m_ps5Stats.renderMs += (start - m_ps5FrameStart).milliseconds();
+
+    // Whole-frame fast path: no CPU diff, no CPU swizzle, no second copy.
+    // Every 8th frame (and the one after) goes the diff way to re-measure.
+    if (m_ps5FastOk && m_ps5WholeMode && (m_ps5ProbeCounter++ % 8) >= 2) {
+        auto fastBitmap = ShareableBitmap::create({ size });
+        if (fastBitmap && fastBitmap->bytesPerRow() == static_cast<unsigned>(size.width()) * 4) {
+            typedef void (*BlitFn)(int, int, int, int, int, int, int, int, unsigned, unsigned);
+            static const BlitFn blit = reinterpret_cast<BlitFn>(ps5_mesa_proc("glBlitFramebuffer"));
+            // GL_READ_FRAMEBUFFER 0x8CA8, GL_DRAW_FRAMEBUFFER 0x8CA9, COLOR_BUFFER_BIT 0x4000, NEAREST 0x2600
+            glBindFramebuffer(0x8CA8, m_ps5Framebuffer);
+            glBindFramebuffer(0x8CA9, m_ps5FlipFramebuffer);
+            blit(0, 0, size.width(), size.height(), 0, size.height(), size.width(), 0, 0x4000, 0x2600);
+            glBindFramebuffer(GL_FRAMEBUFFER, m_ps5FlipFramebuffer);
+            glReadPixels(0, 0, size.width(), size.height(), 0x80E1 /* GL_BGRA_EXT */, GL_UNSIGNED_BYTE, fastBitmap->mutableSpan().data());
+            glBindFramebuffer(GL_FRAMEBUFFER, m_ps5Framebuffer);
+            if (glGetError() == GL_NO_ERROR) {
+                const MonotonicTime fastDone = MonotonicTime::now();
+                m_ps5Stats.readMs += (fastDone - start).milliseconds();
+                if (auto fastHandle = fastBitmap->createHandle()) {
+                    m_ps5HavePrevious = false;
+                    m_ps5Stats.sent++;
+                    m_ps5Stats.fast++;
+                    m_ps5Stats.sentPixels += static_cast<double>(size.width()) * size.height();
+                    ps5LogStats(fastDone);
+                    const IntRect whole(IntPoint(), size);
+                    Vector<IntRect> wholeRects;
+                    wholeRects.append(whole);
+                    m_ps5WaitingForUI = true;
+                    if (m_ps5AckTimer)
+                        m_ps5AckTimer->startOneShot(ps5AckTimeout);
+                    RunLoop::mainSingleton().dispatch([this, protectedThis = Ref { *this }, handle = WTF::move(*fastHandle), whole, rects = WTF::move(wholeRects)]() mutable {
+                        Ref webPage = m_webPage.get();
+                        RefPtr drawingArea = webPage->drawingArea();
+                        if (!drawingArea)
+                            return;
+                        UpdateInfo updateInfo;
+                        updateInfo.viewSize = webPage->size();
+                        updateInfo.deviceScaleFactor = webPage->deviceScaleFactor();
+                        updateInfo.updateRectBounds = whole;
+                        for (const auto& rect : rects)
+                            updateInfo.updateRects.append(rect);
+                        updateInfo.bitmapHandle = WTF::move(handle);
+                        static_cast<DrawingAreaCoordinatedGraphics&>(*drawingArea).ps5SendCompositedUpdate(WTF::move(updateInfo));
+                    });
+                    return;
+                }
+            } else {
+                m_ps5FastOk = false; // this driver cannot do it: use the diff path from now on
+                PS5_SURFACE_LOG("surface: whole-frame fast path failed, off");
+            }
+        }
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, m_ps5Framebuffer);
+    glReadPixels(0, 0, size.width(), size.height(), GL_RGBA, GL_UNSIGNED_BYTE, m_ps5Pixels.mutableSpan().data());
+    const MonotonicTime readDone = MonotonicTime::now();
+    m_ps5Stats.readMs += (readDone - start).milliseconds();
+
+    // The texture pool's own timer cannot release on the main thread here
+    // (BitmapTexturePool.cpp, PS5_HOMEBREW): do it on this thread, with the
+    // compositor's context current, at most every 500 ms.
+    static MonotonicTime lastPoolRelease;
+    if (readDone - lastPoolRelease >= 500_ms) {
+        lastPoolRelease = readDone;
+        BitmapTexturePool::singleton().releaseUnusedTexturesNow();
+    }
+
+    // GL's row 0 is the bottom of the page here (the page came out upside
+    // down on the console without the flip), so rows are reversed;
+    // PROSPEROWEB_GPU_FLIP=0 turns that off.
+    static const bool flip = [] {
+        const char* value = getenv("PROSPEROWEB_GPU_FLIP");
+        return !(value && *value == '0');
+    }();
+
+    // What to send: with Mesa, only the rects that changed since the frame
+    // sent last, and nothing when nothing did.
+    const IntRect whole(IntPoint(), size);
+    Vector<IntRect> rects;
+    const bool diff = ps5MesaActive() && ps5MesaOptions().diff && m_ps5HavePrevious;
+    if (diff) {
+        Vector<IntRect> changed = ps5ChangedRects(m_ps5Pixels.span().data(), m_ps5Previous.span().data(), size.width(), size.height());
+        for (auto& rect : changed) {
+            if (flip)
+                rect.setY(size.height() - rect.maxY());
+            rects.append(rect);
+        }
+    } else
+        rects.append(whole);
+    const MonotonicTime diffDone = MonotonicTime::now();
+    m_ps5Stats.diffMs += (diffDone - readDone).milliseconds();
+    if (m_ps5FastOk && diff) {
+        // The bounds, not the sum: more than 32 small rects are merged into
+        // their bounds before sending, so that is what the frame costs.
+        IntRect changedBounds;
+        for (const auto& rect : rects)
+            changedBounds.unite(rect);
+        const bool mostly = changedBounds.width() * static_cast<double>(changedBounds.height()) > 0.5 * size.width() * size.height();
+        if (mostly != m_ps5WholeMode)
+            m_ps5ProbeCounter = 2;
+        m_ps5WholeMode = mostly;
+    }
+
+    if (rects.isEmpty()) {
+        m_ps5Stats.unchanged++;
+        ps5LogStats(diffDone);
+        ps5FinishFrame();
+        return;
+    }
+    IntRect bounds;
+    double area = 0;
+    for (const auto& rect : rects) {
+        bounds.unite(rect);
+        area += rect.width() * static_cast<double>(rect.height());
+    }
+    // Many small rects cost more to send than their bounds.
+    if (rects.size() > 32) {
+        rects.clear();
+        rects.append(bounds);
+        area = bounds.width() * static_cast<double>(bounds.height());
+    }
+
+    auto bitmap = ShareableBitmap::create({ bounds.size() });
+    if (!bitmap) {
+        ps5FinishFrame();
+        return;
+    }
+    // GL rows are RGBA; the bitmap is Skia's N32 (BGRA in memory).
+    auto destination = bitmap->mutableSpan();
+    const unsigned destinationStride = bitmap->bytesPerRow();
+    const unsigned sourceStride = size.width() * 4;
+    for (const auto& rect : rects) {
+        for (int y = rect.y(); y < rect.maxY(); ++y) {
+            const uint8_t* source = m_ps5Pixels.span().data() + static_cast<size_t>(flip ? size.height() - 1 - y : y) * sourceStride;
+            uint32_t* row = reinterpret_cast<uint32_t*>(destination.data() + static_cast<size_t>(y - bounds.y()) * destinationStride);
+            const uint32_t* in = reinterpret_cast<const uint32_t*>(source);
+            for (int x = rect.x(); x < rect.maxX(); ++x) {
+                const uint32_t p = in[x]; // bytes R G B A
+                row[x - bounds.x()] = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
+            }
+        }
+    }
+    auto handle = bitmap->createHandle();
+    if (!handle) {
+        ps5FinishFrame();
+        return;
+    }
+    // This frame is what the UI side will have: the next one is compared with it.
+    std::swap(m_ps5Pixels, m_ps5Previous);
+    m_ps5HavePrevious = true;
+
+    const MonotonicTime copyDone = MonotonicTime::now();
+    m_ps5Stats.copyMs += (copyDone - diffDone).milliseconds();
+    m_ps5Stats.sent++;
+    m_ps5Stats.sentPixels += area;
+    ps5LogStats(copyDone);
+
+    m_ps5WaitingForUI = true;
+    if (m_ps5AckTimer)
+        m_ps5AckTimer->startOneShot(ps5AckTimeout);
+    RunLoop::mainSingleton().dispatch([this, protectedThis = Ref { *this }, handle = WTF::move(*handle), bounds, rects = WTF::move(rects)]() mutable {
+        Ref webPage = m_webPage.get();
+        RefPtr drawingArea = webPage->drawingArea();
+        if (!drawingArea)
+            return;
+        UpdateInfo updateInfo;
+        updateInfo.viewSize = webPage->size();
+        updateInfo.deviceScaleFactor = webPage->deviceScaleFactor();
+        updateInfo.updateRectBounds = bounds;
+        for (const auto& rect : rects)
+            updateInfo.updateRects.append(rect);
+        updateInfo.bitmapHandle = WTF::move(handle);
+        static_cast<DrawingAreaCoordinatedGraphics&>(*drawingArea).ps5SendCompositedUpdate(WTF::move(updateInfo));
+    });
+}
+
+void AcceleratedSurface::ps5DisplayDidRefresh()
+{
+    ASSERT(RunLoop::isMain());
+    if (!m_ps5WaitingForUI.exchange(false))
+        return;
+    if (!m_ps5RunLoop)
+        return;
+    m_ps5RunLoop->dispatch([this, protectedThis = Ref { *this }] {
+        if (m_ps5AckTimer)
+            m_ps5AckTimer->stop();
+        ps5FinishFrame();
+    });
+}
+
+void AcceleratedSurface::ps5AckTimedOut()
+{
+    if (m_ps5WaitingForUI.exchange(false))
+        ps5FinishFrame();
+}
