+// Mesa options: the words in /data/prosperoweb/mesa (the file that turns Mesa
+// on). "nodiff" sends every frame whole; "pace=N" is the shortest time between
+// two frames in ms (0: none). Read once.
+struct PS5MesaOptions {
+    bool diff { true };
+    bool fast { true };
+    unsigned paceMs { 16 };
+};
+
+static const PS5MesaOptions& ps5MesaOptions()
+{
+    static const PS5MesaOptions options = [] {
+        PS5MesaOptions o;
+        char text[256] = { };
+        int fd = open("/data/prosperoweb/mesa", O_RDONLY);
+        if (fd >= 0) {
+            ssize_t n = read(fd, text, sizeof(text) - 1);
+            close(fd);
+            text[n > 0 ? n : 0] = 0;
+        }
+        if (strstr(text, "nodiff"))
+            o.diff = false;
+        if (strstr(text, "nofast"))
+            o.fast = false;
+        if (const char* pace = strstr(text, "pace="))
+            o.paceMs = static_cast<unsigned>(strtoul(pace + 5, nullptr, 10));
+        return o;
+    }();
+    return options;
+}
+
+#define PS5_SURFACE_LOG(...) do { \
+        if (ps5MesaActive()) { if (ps5_mesa_log) ps5_mesa_log(__VA_ARGS__); } \
+        else if (ps5_glslim_log) ps5_glslim_log(__VA_ARGS__); \
+    } while (0)
+
+// The rects where two read-back frames (GL rows, 4 bytes a pixel) differ, in
+// GL coordinates: the frame is cut into bands of 16 rows; a band's rect runs
+// from its first to its last changed 64-pixel block, and bands with the same
+// span merge.
+static Vector<IntRect> ps5ChangedRects(const uint8_t* current, const uint8_t* previous, int width, int height)
+{
+    static constexpr int bandRows = 16;
+    static constexpr int blockPixels = 64;
+    const size_t stride = static_cast<size_t>(width) * 4;
+    Vector<IntRect> rects;
+    for (int y = 0; y < height; y += bandRows) {
+        const int rows = std::min(bandRows, height - y);
+        int first = -1, last = -1;
+        for (int x = 0; x < width; x += blockPixels) {
+            const size_t bytes = static_cast<size_t>(std::min(blockPixels, width - x)) * 4;
+            for (int r = 0; r < rows; ++r) {
+                const size_t offset = static_cast<size_t>(y + r) * stride + static_cast<size_t>(x) * 4;
+                if (memcmp(current + offset, previous + offset, bytes)) {
+                    if (first < 0)
+                        first = x;
+                    last = std::min(x + blockPixels, width);
+                    break;
+                }
+            }
+        }
+        if (first < 0)
+            continue;
+        IntRect band(first, y, last - first, rows);
+        if (!rects.isEmpty() && rects.last().x() == band.x() && rects.last().width() == band.width() && rects.last().maxY() == band.y())
+            rects.last().setHeight(rects.last().height() + rows);
+        else
+            rects.append(band);
+    }
+    return rects;
+}
